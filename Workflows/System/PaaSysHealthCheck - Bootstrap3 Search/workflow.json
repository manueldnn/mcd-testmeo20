          },
          {
            "Id": 5864,
            "GlobalId": "3ecced2e-15cb-4929-be62-e901161027dc",
            "ActionId": 1181,
            "Name": "SqlQuery",
            "Value": "SELECT\r\n(\r\n    SELECT\r\n        bs.Id AS resourceId,\r\n        'Medium' AS severity,\r\n        JSON_QUERY\r\n        (\r\n            (\r\n                SELECT\r\n                    CASE\r\n                        WHEN bs.Name = 'InputTemplate'\r\n                            THEN 'Search Input Box / Template for Search Input Box'\r\n                        WHEN bs.Name = 'Template'\r\n                            THEN 'Search Results / Template for Search Results'\r\n                    END AS SearchSetting,\r\n\r\n                    CASE\r\n                        WHEN bs.Name = 'InputTemplate'\r\n                             AND bs.Value = 'PageBuilderDefaultSearchBs3'\r\n                            THEN 'PageBuilder Bootstrap 3'\r\n                        WHEN bs.Name = 'InputTemplate'\r\n                             AND bs.Value = 'default'\r\n                            THEN 'Default Bootstrap 3'\r\n                        WHEN bs.Name = 'Template'\r\n                             AND bs.Value = 'PageBuilderDefaultResultsBs3'\r\n                            THEN 'PageBuilder Bootstrap 3'\r\n                        WHEN bs.Name = 'Template'\r\n                             AND bs.Value = 'default'\r\n                            THEN 'Default Bootstrap 3'\r\n                    END AS SettingValue,\r\n\r\n                    bs.Id,\r\n                    bs.BehaviorId,\r\n                    b.Name AS BehaviorName,\r\n                    b.PortalId,\r\n                    pl.PortalName,\r\n                    bs.Name,\r\n                    bs.Value,\r\n                    'true' as paa_preventMajorUpgrades,\r\n                    @ConfigURL AS ConfigURL\r\n                FOR JSON PATH, WITHOUT_ARRAY_WRAPPER\r\n            )\r\n        ) AS properties\r\n    FROM {databaseOwner}[{objectQualifier}DnnSharp_SearchBoost_BehaviorSettings] bs\r\n        INNER JOIN {databaseOwner}[{objectQualifier}DnnSharp_SearchBoost_Behaviors] b\r\n            ON bs.BehaviorId = b.Id\r\n        OUTER APPLY\r\n        (\r\n            SELECT TOP (1)\r\n                pl.PortalName\r\n            FROM {databaseOwner}[{objectQualifier}PortalLocalization] pl\r\n            WHERE pl.PortalID = b.PortalId\r\n            ORDER BY\r\n                CASE WHEN pl.CultureCode = 'en-US' THEN 0 ELSE 1 END,\r\n                pl.CultureCode\r\n        ) pl\r\n    WHERE\r\n        (\r\n            bs.Name = 'InputTemplate'\r\n            AND bs.Value IN ('default', 'PageBuilderDefaultSearchBs3')\r\n        )\r\n        OR\r\n        (\r\n            bs.Name = 'Template'\r\n            AND bs.Value IN ('default', 'PageBuilderDefaultResultsBs3')\r\n        )\r\n    FOR JSON PATH\r\n) AS PAASysAlerts;",
            "ActionStackId": null,
            "ParentParameterId": null,
            "IsExpression": false,
            "OrderIndex": 0,
            "LastModified": "0001-01-01T00:00:00+00:00",
            "LastModifiedBy": null
