          {
            "Id": 5935,
            "GlobalId": "d32c6960-6c1d-47f8-8d5a-533a418feda9",
            "ActionId": 1188,
            "Name": "SqlQuery",
            "Value": "WITH Checks AS (\r\n    SELECT\r\n        IS_MEMBER('db_owner') AS IsDbOwner,\r\n        IS_MEMBER('db_ddladmin') AS IsDdlAdmin,\r\n        HAS_PERMS_BY_NAME(DB_NAME(), 'DATABASE', 'CREATE SCHEMA') AS HasCreateSchema\r\n),\r\nEvaluation AS (\r\n    SELECT\r\n        CASE \r\n            WHEN IsDbOwner = 1 THEN 1\r\n            WHEN IsDdlAdmin = 1 AND HasCreateSchema = 1 THEN 1\r\n            ELSE 0\r\n        END AS IsPass,\r\n        CASE \r\n            WHEN IsDbOwner = 1 THEN NULL\r\n            WHEN IsDdlAdmin = 0 AND HasCreateSchema = 0 \r\n                THEN 'User is missing db_ddladmin role and CREATE SCHEMA permission'\r\n            WHEN IsDdlAdmin = 0 \r\n                THEN 'User is missing db_ddladmin role'\r\n            WHEN HasCreateSchema = 0 \r\n                THEN 'User is missing CREATE SCHEMA permission'\r\n            ELSE 'User does not meet required permission model'\r\n        END AS ErrorMessage\r\n    FROM Checks\r\n)\r\nSELECT \r\n    1 AS resourceId,\r\n    'Critical' AS severity,\r\n    JSON_QUERY(\r\n        (SELECT ErrorMessage AS errorMessage FOR JSON PATH, WITHOUT_ARRAY_WRAPPER)\r\n    ) AS properties\r\nFROM Evaluation\r\nWHERE IsPass = 0\r\nFOR JSON PATH",
            "ActionStackId": null,
            "ParentParameterId": null,
            "IsExpression": false,
            "OrderIndex": 0,
            "LastModified": "0001-01-01T00:00:00+00:00",
            "LastModifiedBy": null
