            "GlobalId": "73b1fccd-db1e-4507-9e6c-92e754c5eb7f",
            "ActionId": 1173,
            "Name": "SqlQuery",
            "Value": "SELECT\r\n(\r\n    SELECT\r\n        ev.Id AS resourceId,\r\n        'Medium' AS severity,\r\n        JSON_QUERY\r\n        (\r\n            (\r\n                SELECT\r\n                    ev.Id,\r\n                    ev.Name,\r\n                    ev.PageUiLibrary,\r\n                    'true' as paa_preventMajorUpgrades,\r\n                    @ConfigURL as ConfigURL\r\n                FOR JSON PATH, WITHOUT_ARRAY_WRAPPER\r\n            )\r\n        ) AS properties\r\n    FROM {databaseOwner}[{objectQualifier}PlantAnApp_Configuration_Entities_EntityVersion] ev\r\n    WHERE ev.PageUiLibrary = 1\r\n    FOR JSON PATH\r\n) AS PAASysAlerts;",
            "ActionStackId": null,
            "ParentParameterId": null,
            "IsExpression": false,
            "OrderIndex": 0,
            "LastModified": "0001-01-01T00:00:00+00:00",
